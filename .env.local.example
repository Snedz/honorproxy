# HonorProxy Environment Variables
# Copy this file to .env.local and fill in your values (never commit .env.local)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# IMPORTANT: Use the "anon" "public" key (NOT the service_role secret key) from Supabase Dashboard > Project Settings > API > Project API keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# For future server-side admin operations (optional in MVP)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Email (Resend)
RESEND_API_KEY=re_your_key_here

# Production from address — strongly recommended for real deliveries
# Format: "HonorProxy <visits@yourdomain.com>"
# RESEND_FROM_EMAIL="HonorProxy <visits@yourdomain.com>"

# Without this variable, the app falls back to Resend's testing address (onboarding@resend.dev),
# which only delivers to the address you signed up with.
